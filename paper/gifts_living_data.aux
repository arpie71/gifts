\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Recurrence of agency-country ties after the original carriers leave (O). Unit: an agency-country tie observed in year $t$ through linked recipients. Recurrence: the country gives to the agency again in $t+1$ to $t+3$. Panel A shows shares; Panel B shows linear probability models with agency-by-year and country-by-year fixed effects and log number of carriers, with standard errors clustered by agency. When all carriers leave, recurrence through the original carrier is zero by construction. The ties come from 27 agencies, 21 of which remain after singleton groups are dropped.}}{21}{table.caption.21}\protected@file@percent }
\newlabel{tab:rev_continuity}{{9}{21}{Recurrence of agency-country ties after the original carriers leave (O). Unit: an agency-country tie observed in year $t$ through linked recipients. Recurrence: the country gives to the agency again in $t+1$ to $t+3$. Panel A shows shares; Panel B shows linear probability models with agency-by-year and country-by-year fixed effects and log number of carriers, with standard errors clustered by agency. When all carriers leave, recurrence through the original carrier is zero by construction. The ties come from 27 agencies, 21 of which remain after singleton groups are dropped}{table.caption.21}{}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Do foreign contacts follow the person? Episodes in which a linked recipient is observed under agency A and later under agency B. Row 1: the share of the mover's gifts at B that come from countries that gave to them at A, against the same share among B's other recipients in the same years. Row 2: the same for specific foreign individuals. Row 3: at A, the share of other recipients' gifts from the mover's countries in the three years after the move against the three years before. $p$-values from 5,000 sign-flip permutations.}}{21}{table.caption.22}\protected@file@percent }
\newlabel{tab:rev_movers}{{10}{21}{Do foreign contacts follow the person? Episodes in which a linked recipient is observed under agency A and later under agency B. Row 1: the share of the mover's gifts at B that come from countries that gave to them at A, against the same share among B's other recipients in the same years. Row 2: the same for specific foreign individuals. Row 3: at A, the share of other recipients' gifts from the mover's countries in the three years after the move against the three years before. $p$-values from 5,000 sign-flip permutations}{table.caption.22}{}}
\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces Top brokers by position (X). Recipients with at least three gifts and a plausible identifier link ($N=311$), ranked by betweenness in the 1998--2023 graph of recipients, reporting agencies, and giving countries. ``Position held in gift years'' is the Wikidata position covering the years of the person's gifts (weighted by gifts), else the title in the gift record. ``Rank'' is the overall rank. Participation and number of communities (``Comm.'') come from the recipient-country graph, with Louvain communities (seeded).}}{22}{table.caption.23}\protected@file@percent }
\newlabel{tab:rev_brokers}{{11}{22}{Top brokers by position (X). Recipients with at least three gifts and a plausible identifier link ($N=311$), ranked by betweenness in the 1998--2023 graph of recipients, reporting agencies, and giving countries. ``Position held in gift years'' is the Wikidata position covering the years of the person's gifts (weighted by gifts), else the title in the gift record. ``Rank'' is the overall rank. Participation and number of communities (``Comm.'') come from the recipient-country graph, with Louvain communities (seeded)}{table.caption.23}{}}
